@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultFontColor #243247
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #55708F
skinparam dpi 150
skinparam sequence {
  ParticipantBackgroundColor #EAF1F8
  ParticipantBorderColor #54708E
  LifeLineBorderColor #8A9BB0
  ArrowColor #54708E
}

 title Тренувальна діаграма послідовності — Оплата замовлення

actor "Покупець" as Customer
participant "Вебзастосунок" as App
participant "Платіжний сервіс" as Payment

Customer -> App : обратиТовар(ідентифікатор)
Customer -> App : оформитиЗамовлення(дані)
App -> Payment : оплатити(сума)
Payment --> App : результатОплати(статус)

legend left
  **Легенда**
  Учасники розташовані зверху
  Повідомлення читаються згори вниз
  Суцільна стрілка — виклик операції
  Пунктирна стрілка — відповідь
  --
  Автор: [ПІБ студента] | Версія: 1.0 | Дата: 22.11.2026
endlegend
@enduml
